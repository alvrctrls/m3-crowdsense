# GEMINI_API_KEY: Optional server-side key if AI studio endpoints are used.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""

# VITE_M3_API_BASE_URL: Optional base URL for future m3 commuter app data provider integration.
# Leave empty to run in deterministic Demo Mode (DemoM3DataProvider).
VITE_M3_API_BASE_URL=""

# VITE_MAPTILER_API_KEY: Optional MapTiler API key for raster/vector tile backdrop on the Demand Map.
# When omitted, m3 CrowdSense uses its built-in interactive Nairobi GIS demonstration map.
VITE_MAPTILER_API_KEY=""
